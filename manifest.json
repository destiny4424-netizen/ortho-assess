{
  "name": "Ortho Assess",
  "short_name": "Ortho Assess",
  "description": "Orthodontic case assessment — records stay on this device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f5f6f8",
  "theme_color": "#1d4ed8",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{
        "name": "files",
        "accept": ["image/*", "application/pdf", "application/dicom", "application/zip", "application/x-zip-compressed",
                   "application/octet-stream", "model/stl", "application/sla", "model/obj", "model/ply",
                   ".stl", ".obj", ".ply", ".dcm", ".zip", ".heic", ".heif", ".tif", ".tiff", ".pdf", ".jpg", ".jpeg", ".png"]
      }]
    }
  }
}
